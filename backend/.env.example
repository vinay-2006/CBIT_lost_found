# ==============================================================================
# CBIT Lost & Found Portal - Backend Configuration (MongoDB Edition)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/cbit_lost_found
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cbit_lost_found?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cbit_lost_found

# Authentication Secret for JWT verification
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Dedicated Upload Storage Directory (on disk, outside MongoDB)
UPLOAD_DIR=uploads

# Maximum file upload size in bytes (default: 5MB = 5242880 bytes)
MAX_FILE_SIZE_BYTES=5242880
